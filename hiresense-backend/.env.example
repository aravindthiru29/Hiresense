FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=hiresense_super_secret_dev_key_2026
JWT_SECRET_KEY=hiresense_jwt_secret_dev_key_2026
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database: PostgreSQL (or fallback to SQLite if postgres is not running locally)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiresense
# For SQLite local fallback, you can set:
# DATABASE_URL=sqlite:///hiresense.db

FRONTEND_URL=http://localhost:5173

# Pluggable AI Service: set AI_API_KEY to activate RealAIService, otherwise MockAIService will run
AI_API_KEY=
AI_MODEL=gemini-1.5-pro

# GitHub integration (optional personal token for higher rate limits)
GITHUB_TOKEN=

# Uploads directory
UPLOAD_FOLDER=uploads/resumes
MAX_CONTENT_LENGTH=10485760
